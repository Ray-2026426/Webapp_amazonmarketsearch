{
  "headers": [
    {
      "source": "/favicon.svg",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api-proxy/gemini/(.*)",
      "destination": "https://generativelanguage.googleapis.com/$1"
    },
    {
      "source": "/api-proxy/openai/(.*)",
      "destination": "https://api.openai.com/$1"
    },
    {
      "source": "/api-proxy/deepseek/(.*)",
      "destination": "https://openrouter.fans/$1"
    },
    {
      "source": "/api-proxy/claude/(.*)",
      "destination": "https://api.anthropic.com/$1"
    },
    {
      "source": "/api-proxy/qwen/(.*)",
      "destination": "https://dashscope.aliyuncs.com/$1"
    },
    {
      "source": "/api-proxy/moonshot/(.*)",
      "destination": "https://api.moonshot.cn/$1"
    },
    {
      "source": "/api-proxy/zhipu/(.*)",
      "destination": "https://open.bigmodel.cn/$1"
    },
    {
      "source": "/api-proxy/sellersprite-mcp",
      "destination": "https://mcp.sellersprite.com/mcp"
    },
    {
      "source": "/api-proxy/sellersprite-mcp/(.*)",
      "destination": "https://mcp.sellersprite.com/mcp/$1"
    },
    {
      "source": "/api-proxy/xydc-mcp",
      "destination": "https://mcp.xydc.com/mcp"
    },
    {
      "source": "/api-proxy/xydc-mcp/(.*)",
      "destination": "https://mcp.xydc.com/mcp/$1"
    },
    {
      "source": "/api-proxy/lingxing-mcp",
      "destination": "https://openmcp.lingxing.com/mcp-servers/lingxing-mcp"
    },
    {
      "source": "/api-proxy/lingxing-mcp/(.*)",
      "destination": "https://openmcp.lingxing.com/mcp-servers/lingxing-mcp/$1"
    },
    {
      "source": "/api-proxy/sorftime-mcp",
      "destination": "https://mcp.sorftime.com/"
    },
    {
      "source": "/api-proxy/sorftime-mcp/(.*)",
      "destination": "https://mcp.sorftime.com/$1"
    }
  ]
}
