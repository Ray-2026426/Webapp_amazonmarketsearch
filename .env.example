# AI 默认供应商：DeepSeek（在应用「AI 设置」里填 Key 即可）
VITE_DEFAULT_AI_PROVIDER=deepseek
VITE_DEFAULT_AI_MODEL=deepseek-chat
VITE_DEFAULT_AI_KEY=

# 卖家精灵 MCP（仅服务端读取，不会打进前端包）
# 与 Cursor mcp.json 里 sellersprite-mcp 的 secret-key 相同
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
SELLERSPRITE_SECRET_KEY=

# 可选：旧 Gemini Key（仅在你主动切回 Gemini 时用到）
GEMINI_API_KEY=
APP_URL=
