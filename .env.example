# AI 默认供应商：DeepSeek（在应用「设置 → API 与模型」里填 Key）
VITE_DEFAULT_AI_PROVIDER=deepseek
VITE_DEFAULT_AI_MODEL=deepseek-chat
VITE_DEFAULT_AI_KEY=

# ── 管理员白名单（多个用英文逗号分隔）─────────────────────────────
# ADMIN_EMAILS 是**唯一权威**来源（服务端判定）：/api/auth/login、/api/auth/me 都按它下发 isAdmin，
# 前端「设置 → 管理员后台 / 团队空间」据此显示。改完本地重启 dev server、线上刷新页面即生效，
# **不需要重新部署**（因为不依赖构建期注入）。
ADMIN_EMAILS=
# VITE_ADMIN_EMAILS 仅为老版本兼容的兜底（构建期注入，且会把邮箱明文打进前端 JS 包）——新部署请留空。
VITE_ADMIN_EMAILS=

# 卖家精灵 MCP：管理员账号会自动预填下面的默认 Key
SELLERSPRITE_MCP_URL=https://mcp.sellersprite.com/mcp
SELLERSPRITE_SECRET_KEY=
VITE_DEFAULT_SELLERSPRITE_SECRET_KEY=

# 西柚洞察 MCP：管理员账号会自动预填下面的默认 Key
VITE_DEFAULT_XYDC_SECRET_KEY=
XYDC_MCP_URL=https://mcp.xydc.com/mcp
LINGXING_SECRET_KEY=
SORFTIME_SECRET_KEY=

GEMINI_API_KEY=
APP_URL=

# Supabase：后端用 service_role 统一访问，客户端不直接接触 Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
APP_JWT_SECRET=
